# Copy to .env. Never commit .env.

# Applied only when the db-data volume is first created.
# To change later: `docker compose down -v` (deletes the data).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=currency_converter
POSTGRES_PORT=5433

# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://app:app@localhost:5433/currency_converter
NODE_ENV=development
PORT=3100
